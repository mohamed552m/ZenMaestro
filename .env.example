# CoachAI's development/runtime database is local PostgreSQL. Copy this file
# to .env and replace <PASSWORD>; never commit the populated .env file.
DATABASE_URL=postgresql+psycopg2://coachai_user:<PASSWORD>@127.0.0.1:5432/coachai
# Optional comma-separated exact browser origins. Leave empty for native-only/local use.
COACHAI_CORS_ALLOWED_ORIGINS=

# Mobile authentication and encrypted Calendar credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
COACHAI_ENVIRONMENT=production
# Keep true in production with Admin credentials. Local token-signature testing
# can set false when Application Default Credentials are intentionally absent.
FIREBASE_CHECK_REVOKED=true
COACHAI_TOKEN_ENCRYPTION_KEY=

# Optional Gemini planning/coaching/voice features. Leave the key empty to
# disable provider-backed AI calls.
GOOGLE_API_KEY=
COACHAI_AI_TIMEOUT_SECONDS=35
COACHAI_CHAT_MODEL=gemini-3.1-flash-lite
COACHAI_CHAT_FALLBACK_MODEL=gemini-3.5-flash
COACHAI_CHAT_TOTAL_TIMEOUT_SECONDS=80
COACHAI_CHAT_TOOL_ROUNDS=2
COACHAI_CHAT_OUTPUT_TOKENS=1024
COACHAI_PLANNER_MODEL=gemini-3.1-flash-lite
COACHAI_PLANNER_FALLBACK_MODEL=gemini-3.5-flash
COACHAI_FUTURE_PLANNER_MODEL=gemini-3.1-flash-lite
COACHAI_FUTURE_PLANNER_FALLBACK_MODEL=gemini-3.5-flash
COACHAI_VOICE_MODEL=gemini-3.1-flash-lite
COACHAI_VOICE_FALLBACK_MODEL=gemini-3.5-flash

# CoachAI push providers are disabled unless explicitly enabled.
# Never commit service-account JSON files, APNs .p8 files, or device tokens.

COACHAI_FCM_ENABLED=false
COACHAI_FCM_CREDENTIALS=C:/secure/path/firebase-service-account.json
COACHAI_FCM_PROJECT_ID=your-firebase-project-id
COACHAI_FCM_DRY_RUN=false

COACHAI_APNS_ENABLED=false
COACHAI_APNS_ENVIRONMENT=sandbox
COACHAI_APNS_KEY_ID=YOUR_KEY_ID
COACHAI_APNS_TEAM_ID=YOUR_TEAM_ID
COACHAI_APNS_BUNDLE_ID=com.example.coachai
COACHAI_APNS_PRIVATE_KEY=C:/secure/path/AuthKey_KEYID.p8

COACHAI_PUSH_TIMEOUT_SECONDS=10
