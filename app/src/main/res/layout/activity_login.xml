<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chalk_white"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:background="@drawable/bg_auth_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <com.zenmaestro.app.ZenMarkView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:contentDescription="ZenMaestro logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/app_name"
            android:textColor="@color/chalk_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.2"
            android:text="@string/brand_motto"
            android:textColor="@color/sage"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="198dp"
        android:background="@drawable/bg_auth_sheet"
        android:elevation="10dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="27dp"
            android:paddingTop="27dp"
            android:paddingEnd="27dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/welcome_back"
                android:textColor="@color/chalkboard"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:text="@string/login_subtitle"
                android:textColor="@color/chalk_line"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_address"
                app:boxBackgroundColor="@color/paper_white"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/input_stroke"
                app:hintTextColor="@color/chalk_line"
                app:startIconDrawable="@drawable/ic_mail"
                app:startIconTint="@color/chalkboard">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/chalkboard"
                    android:textColorHint="@color/sage" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:hint="@string/password"
                app:boxBackgroundColor="@color/paper_white"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/input_stroke"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/chalk_line"
                app:hintTextColor="@color/chalk_line"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/chalkboard">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/chalkboard" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="5dp"
                android:text="@string/forgot_password"
                android:textColor="#4D6FA8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/log_in"
                android:textAllCaps="false"
                android:textColor="@color/chalk_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/chalkboard"
                app:cornerRadius="17dp"
                app:rippleColor="@color/sage_green" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#443A5245" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="@string/or"
                    android:textColor="@color/sage"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#443A5245" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_google_button"
                android:text="@string/continue_google"
                android:textAllCaps="false"
                android:textColor="@color/chalkboard"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_google_g"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                app:rippleColor="@color/dusty_blue" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_to_zenmaestro"
                    android:textColor="@color/chalk_line"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSignupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/sign_up"
                    android:textAllCaps="false"
                    android:textColor="@color/chalkboard"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sage_green"
                    app:cornerRadius="19dp"
                    app:rippleColor="@color/chalk_gold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
