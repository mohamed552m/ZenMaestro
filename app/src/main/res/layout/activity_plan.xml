<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chalk_white"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/planScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/bottom_navigation_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/my_plan"
                        android:textColor="@color/chalkboard"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selectedDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/sage"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/planOptionsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_secondary_action"
                    android:contentDescription="@string/plan_options"
                    android:padding="10dp"
                    android:src="@drawable/ic_more_horizontal" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/paper_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/sage_tint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="7dp">

                    <com.google.android.material.button.MaterialButton android:id="@+id/dayMonday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dayTuesday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dayWednesday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dayThursday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dayFriday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/daySaturday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/daySunday" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:padding="0dp" android:textAllCaps="false" android:textSize="9sp" app:backgroundTint="@color/plan_day_background" app:cornerRadius="13dp" app:rippleColor="@color/sage_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/planModeGroup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@color/sage_tint"
                android:padding="4dp"
                app:checkedButton="@id/modeZenButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeZenButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/with_zen"
                    android:textAllCaps="false"
                    android:textColor="@color/plan_mode_text"
                    android:textSize="10sp"
                    app:backgroundTint="@color/plan_mode_background"
                    app:icon="@drawable/ic_nav_coach"
                    app:iconPadding="5dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/plan_mode_text"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeVoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/voice"
                    android:textAllCaps="false"
                    android:textColor="@color/plan_mode_text"
                    android:textSize="10sp"
                    app:backgroundTint="@color/plan_mode_background"
                    app:icon="@drawable/ic_mic"
                    app:iconPadding="5dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/plan_mode_text"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeManualButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/manual"
                    android:textAllCaps="false"
                    android:textColor="@color/plan_mode_text"
                    android:textSize="10sp"
                    app:backgroundTint="@color/plan_mode_background"
                    app:icon="@drawable/ic_add"
                    app:iconPadding="5dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/plan_mode_text"
                    app:strokeWidth="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/chalkboard"
                app:cardCornerRadius="24dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_with_zen"
                        android:textColor="@color/sage_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/composerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/describe_learning_day"
                        android:textColor="@color/chalk_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/composerMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/describe_learning_day_message"
                        android:textColor="@color/sage"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/zenInputPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/zenPlanInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@color/chalkboard_light"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="17dp"
                            app:boxCornerRadiusBottomStart="17dp"
                            app:boxCornerRadiusTopEnd="17dp"
                            app:boxCornerRadiusTopStart="17dp"
                            app:boxStrokeColor="@color/chalk_line"
                            app:hintTextColor="@color/sage">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/zenPlanInput"
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                android:gravity="top|start"
                                android:hint="@string/plan_input_hint"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLines="6"
                                android:padding="15dp"
                                android:textColor="@color/chalk_white"
                                android:textColorHint="@color/sage"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buildPlanButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="11dp"
                            android:text="@string/build_my_plan"
                            android:textAllCaps="false"
                            android:textColor="@color/chalkboard"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/sage_green"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_nav_coach"
                            app:iconPadding="7dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/chalkboard" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/voiceInputPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="142dp"
                            app:cardBackgroundColor="@color/chalkboard_light"
                            app:cardCornerRadius="17dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/chalk_line"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/recordVoiceButton"
                                    android:layout_width="58dp"
                                    android:layout_height="58dp"
                                    android:minWidth="0dp"
                                    android:padding="16dp"
                                    android:text=""
                                    app:backgroundTint="@color/sage_green"
                                    app:cornerRadius="29dp"
                                    app:icon="@drawable/ic_mic"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="24dp"
                                    app:iconTint="@color/chalkboard" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="9dp"
                                    android:text="@string/tap_describe_day"
                                    android:textColor="@color/chalk_white"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="@string/voice_review_message"
                                    android:textColor="@color/sage"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/voiceTranscriptLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:boxBackgroundColor="@color/chalkboard_light"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="15dp"
                            app:boxCornerRadiusBottomStart="15dp"
                            app:boxCornerRadiusTopEnd="15dp"
                            app:boxCornerRadiusTopStart="15dp"
                            app:boxStrokeColor="@color/chalk_line">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/voiceTranscriptInput"
                                android:layout_width="match_parent"
                                android:layout_height="90dp"
                                android:gravity="top|start"
                                android:hint="@string/review_transcript"
                                android:inputType="textCapSentences|textMultiLine"
                                android:padding="14dp"
                                android:textColor="@color/chalk_white"
                                android:textColorHint="@color/sage" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buildVoicePlanButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/build_from_transcript"
                            android:textAllCaps="false"
                            android:textColor="@color/chalkboard"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="@color/sage_green"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/manualInputPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/chalkboard_light"
                            android:padding="14dp"
                            android:text="@string/manual_task_message"
                            android:textColor="@color/sage"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addManualTaskButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/open_manual_task_form"
                            android:textAllCaps="false"
                            android:textColor="@color/chalkboard"
                            android:textStyle="bold"
                            app:backgroundTint="@color/sage_green"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_add"
                            app:iconPadding="7dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/chalkboard" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dayPlanTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/todays_plan_title"
                    android:textColor="@color/chalkboard"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dayPlanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/waiting_input"
                    android:textColor="@color/sage"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/planDraftNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/sage_tint"
                android:padding="12dp"
                android:text="@string/plan_draft_note"
                android:textColor="@color/chalk_line"
                android:textSize="10sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emptyStateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/paper_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/sage_tint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:cardBackgroundColor="@color/sage_tint"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_task_pending" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_tasks_yet"
                            android:textColor="@color/chalkboard"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/no_tasks_options"
                            android:textColor="@color/sage"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/taskListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/planActionRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedulePlanButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.35"
                    android:text="@string/schedule_my_day"
                    android:textAllCaps="false"
                    android:textColor="@color/chalkboard"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sage_green"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_calendar_clock"
                    app:iconPadding="6dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/chalkboard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addBreakButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.65"
                    android:text="@string/break_label"
                    android:textAllCaps="false"
                    android:textColor="@color/chalkboard"
                    android:textSize="10sp"
                    app:backgroundTint="@color/paper_white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_coffee"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/chalkboard"
                    app:strokeColor="@color/sage_tint"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
