<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chalk_white"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/chalkboard"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/notificationButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/notifications"
                    android:padding="9dp"
                    android:src="@drawable/ic_notifications" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/streakCard"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/chalkboard"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="1dp"
                    app:rippleColor="@color/chalk_line">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/streak"
                            android:src="@drawable/ic_streak" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="@color/chalk_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/streak"
                                android:textColor="@color/sage_green"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/chalkboard"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="17dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_focus"
                            android:textColor="@color/sage_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/android_security"
                            android:textColor="@color/chalk_white"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/continue_webview"
                            android:textColor="@color/chalk_white"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="@string/focus_progress"
                            android:textColor="@color/sage"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="78"
                                app:indicatorColor="@color/sage_green"
                                app:trackColor="@color/chalk_line"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="7dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:text="@string/progress_78"
                                android:textColor="@color/sage_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/continueButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1.25"
                                android:minWidth="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="7dp"
                                android:text="@string/continue_learning"
                                android:textAllCaps="false"
                                android:textColor="@color/chalkboard"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/sage_green"
                                app:cornerRadius="11dp"
                                app:icon="@drawable/ic_play"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/chalkboard" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/askZenButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="7dp"
                                android:layout_weight="0.9"
                                android:minWidth="0dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:text="@string/ask_zen"
                                android:textAllCaps="false"
                                android:textColor="@color/chalk_white"
                                android:textSize="11sp"
                                app:backgroundTint="@color/transparent"
                                app:cornerRadius="11dp"
                                app:icon="@drawable/ic_chat"
                                app:iconPadding="4dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/chalk_white"
                                app:strokeColor="@color/sage"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="82dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.zenmaestro.app.ZenMarkView
                            android:layout_width="82dp"
                            android:layout_height="96dp"
                            android:contentDescription="ZenMaestro logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/zen_mark"
                            android:textColor="@color/sage_green"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/paper_white"
                app:cardCornerRadius="17dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/sage_tint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="98dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="@string/streak"
                            android:src="@drawable/ic_streak" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textColor="@color/chalkboard"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak"
                            android:textColor="@color/chalk_line"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/days_in_a_row"
                            android:textColor="@color/sage"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="62dp"
                        android:background="#303A5245" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="@string/level_7"
                            android:src="@drawable/ic_level" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/level_7"
                            android:textColor="@color/chalkboard"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/keep_going"
                            android:textColor="@color/sage"
                            android:textSize="9sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="42dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="70"
                            app:indicatorColor="@color/dusty_blue"
                            app:trackColor="@color/sage_tint"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="62dp"
                        android:background="#303A5245" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:contentDescription="@string/total_xp"
                            android:src="@drawable/ic_xp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xp_640"
                            android:textColor="@color/chalkboard"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_xp"
                            android:textColor="@color/sage"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="62dp"
                        android:background="#303A5245" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="78"
                                app:indicatorColor="@color/dusty_blue"
                                app:indicatorSize="48dp"
                                app:trackColor="@color/sage_tint"
                                app:trackThickness="5dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/progress_78"
                                android:textColor="@color/chalkboard"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today"
                            android:textColor="@color/chalkboard"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_completion"
                            android:textColor="@color/sage"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sage_tint"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/sage_green"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/practice"
                            android:src="@drawable/ic_book" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_task"
                            android:textColor="@color/chalk_line"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/practice_webview_lab"
                            android:textColor="@color/chalkboard"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="30 min   •   Practice"
                            android:textColor="@color/chalk_line"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startTaskButton"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="7dp"
                        android:text="@string/start"
                        android:textAllCaps="false"
                        android:textColor="@color/chalk_white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/chalkboard"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="textEnd"
                        app:iconPadding="5dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/chalk_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/paper_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/sage_tint"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/today_plan"
                            android:textColor="@color/chalk_line"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewAllButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:text="@string/view_all"
                            android:textAllCaps="false"
                            android:textColor="@color/chalk_line"
                            android:textSize="10sp"
                            app:icon="@drawable/ic_chevron_right"
                            app:iconGravity="textEnd"
                            app:iconPadding="2dp"
                            app:iconSize="14dp"
                            app:iconTint="@color/chalk_line" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="1dp"
                            android:layout_height="155dp"
                            android:layout_marginStart="11dp"
                            android:layout_marginTop="24dp"
                            android:background="#668FA396" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:contentDescription="@string/task_completed"
                                    android:src="@drawable/ic_check_circle" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/review_notes"
                                        android:textColor="@color/chalkboard"
                                        android:fontFamily="sans-serif-medium"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="10 min   •   Reading"
                                        android:textColor="@color/sage"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/view_all"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/sage" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:contentDescription="@string/task_pending"
                                    android:src="@drawable/ic_task_pending" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/webview_security"
                                        android:textColor="@color/chalkboard"
                                        android:fontFamily="sans-serif-medium"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="45 min   •   Study"
                                        android:textColor="@color/sage"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/view_all"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/sage" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:contentDescription="@string/task_pending"
                                    android:src="@drawable/ic_task_pending" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/solve_lab"
                                        android:textColor="@color/chalkboard"
                                        android:fontFamily="sans-serif-medium"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="30 min   •   Practice"
                                        android:textColor="@color/sage"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/view_all"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/sage" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:contentDescription="@string/task_pending"
                                    android:src="@drawable/ic_task_pending" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/daily_reflection"
                                        android:textColor="@color/chalkboard"
                                        android:fontFamily="sans-serif-medium"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="10 min   •   Reflect"
                                        android:textColor="@color/sage"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/view_all"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/sage" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="@color/paper_white"
        android:elevation="12dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_nav_item_colors"
        app:itemRippleColor="@color/sage_tint"
        app:itemTextColor="@color/bottom_nav_item_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/home_bottom_nav" />

</FrameLayout>
